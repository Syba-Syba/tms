# Threshold, hosted. Copy to .env.production next to docker-compose.yml, fill in, and keep it
# off GitHub (it is ignored). Then: docker compose --env-file .env.production up -d --build

# The address landlords and tenants open. Its DNS A record must point at this server before the
# first start, so Caddy can get the certificate.
DOMAIN=app.example.co.za
PUBLIC_APP_URL=https://app.example.co.za
PUBLIC_API_URL=https://app.example.co.za

# Postgres. Any long random string; the database is reachable only through its socket.
DB_PASSWORD=

# Both from `cd tms/api && npm run secrets:generate`. STORAGE_SECRET derives the key for ID
# numbers and two-step secrets: lose it and those are unreadable. Keep a copy off this server.
AUTH_SECRET=
STORAGE_SECRET=
AUTH_DRIVER=local
KMS_DRIVER=local

# Placeholders lib/env.ts requires; unused when self-hosted.
AWS_REGION=af-south-1
DB_SECRET_ARN=unused
DOCS_BUCKET=unused
KMS_KEY_ID=unused

# Email out: tenants' notices, password resets, invites, alerts.
NOTIFY_MODE=smtp
SMTP_URL=smtps://user:password@smtp.example.co.za:465
NOTIFY_FROM=Threshold <no-reply@example.co.za>
NOTIFY_REPLY_TO=support@example.co.za

# Where errors and failed jobs are emailed. Use an inbox someone reads.
ALERT_EMAIL=

# The business that sells Threshold. It prints on the terms of service and on every invoice
# to landlords. With COMPANY_VAT_NO set, invoices are tax invoices showing 15% VAT.
COMPANY_NAME=Threshold
COMPANY_LEGAL_NAME=
COMPANY_REG_NO=
COMPANY_VAT_NO=
COMPANY_ADDRESS=
COMPANY_EMAIL=
COMPANY_PHONE=

# Billing. payfast charges landlords; leave PAYFAST_SANDBOX=true until the sandbox run passes.
BILLING_DRIVER=payfast
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true

# Optional: WhatsApp through Meta's Cloud API.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE=threshold_update

# Backups: kept BACKUP_KEEP_DAYS days here and, when BACKUP_REMOTE is set, copied off the
# server; copies there older than BACKUP_KEEP_DAYS are deleted too. A failed copy keeps the
# local one but turns /health red. rclone reads its remotes from RCLONE_CONFIG_<NAME>_*
# variables.
BACKUP_KEEP_DAYS=14
# The backups hold tenants' ID numbers and documents (POPIA): send them through an rclone
# `crypt` remote, so the bucket only ever holds ciphertext. Two remotes: `offsite`, any
# S3-compatible bucket (Backblaze B2, Cloudflare R2, AWS S3, Wasabi), and `secure`, which
# encrypts into it. Point BACKUP_REMOTE at `secure`, never straight at `offsite`.
# BACKUP_REMOTE=secure:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Other
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_SECURE_TYPE=crypt
# RCLONE_CONFIG_SECURE_REMOTE=offsite:threshold-backups
# Both obscured, not plain: docker run --rm rclone/rclone obscure "$(openssl rand -base64 32)"
# Keep the plain passwords off this server too (password manager): without them the copies
# off the server cannot be decrypted.
# RCLONE_CONFIG_SECURE_PASSWORD=
# RCLONE_CONFIG_SECURE_PASSWORD2=
