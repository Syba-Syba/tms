# HTTPS for the app, with a certificate from Let's Encrypt that Caddy renews itself. DOMAIN is
# the address landlords use, e.g. app.threshold.co.za; its DNS must point at this server.
{$DOMAIN} {
	encode zstd gzip
	# Browsers that have been here once refuse plain HTTP to this address for a year.
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy app:3001
	# Uploads go through the API, which caps them at 15 MB; this keeps anything larger off it.
	request_body {
		max_size 16MB
	}
	# Access log on stdout, rotated by Docker (see docker-compose.yml). Reset and invite links
	# carry ?token= and signed file links ?sig=; neither is written to the log. Caddy already
	# leaves out Cookie and Authorization headers.
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>uri query {
					replace token REDACTED
					replace sig REDACTED
				}
			}
		}
	}
}
