{
  "name": "tms-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync android",
    "apk:debug": "npm run sync && cd android && ./gradlew assembleDebug",
    "apk:release": "npm run sync && cd android && ./gradlew bundleRelease assembleRelease",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predev": "node -e \"process.exit(require('fs').existsSync('../../toolbox/dist/index.js')?0:1)\" || npm --prefix ../../toolbox run build",
    "prebuild": "npm --prefix ../../toolbox run build",
    "test:clicks": "vitest run src/__clicks__"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/camera": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/filesystem": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/push-notifications": "^6.0.2",
    "@hlonie/toolbox": "*",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.27.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20.19"
  }
}
