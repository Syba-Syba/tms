# Copy to .env. Vite only exposes variables prefixed with VITE_.
VITE_API_URL=http://localhost:3001

# Development only. The local API has no Cognito, so src/local.ts reads identity from these
# headers instead. Set them to switch between the seeded landlord and the seeded tenant.
VITE_DEV_SUB=sub-landlord
VITE_DEV_GROUPS=landlord
