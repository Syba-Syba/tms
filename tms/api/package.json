{
  "name": "tms-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "deploy": "serverless deploy",
    "deploy:dev": "serverless deploy --stage dev",
    "logs": "serverless logs -f api -t",
    "migrate": "node --env-file=.env scripts/migrate.mjs",
    "migrate:deploy": "node scripts/migrate.mjs",
    "test": "vitest run",
    "predev": "node --env-file=.env scripts/ensure-dev-db.mjs",
    "dev": "tsx --env-file=.env src/local.ts",
    "db:create": "createdb tms 2>/dev/null || true",
    "migrate:dry": "node --env-file=.env scripts/migrate.mjs --dry-run",
    "setup": "node --env-file=.env scripts/migrate.mjs --seed",
    "reset": "node scripts/reset.mjs",
    "certs:fetch": "node scripts/fetch-ca.mjs",
    "predeploy": "npm run certs:fetch",
    "predeploy:dev": "npm run certs:fetch",
    "prepackage": "npm run certs:fetch",
    "package": "serverless package",
    "start": "tsx --env-file=.env.selfhosted src/server.ts",
    "jobs": "tsx --env-file=.env.selfhosted src/jobs.ts",
    "secrets:generate": "node scripts/generate-secrets.mjs",
    "bootstrap": "tsx --env-file=.env.selfhosted scripts/bootstrap.mjs",
    "migrate:selfhosted": "node --env-file=.env.selfhosted --import tsx scripts/migrate.mjs",
    "db:psql": "node --env-file=.env.selfhosted scripts/db-shell.mjs",
    "db:dump": "node --env-file=.env.selfhosted scripts/db-shell.mjs dump"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.670.0",
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/client-secrets-manager": "^3.670.0",
    "@aws-sdk/client-sesv2": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@electric-sql/pglite": "^0.5.4",
    "nodemailer": "^10.1.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.25.0",
    "serverless": "^3.39.0",
    "serverless-esbuild": "^1.57.2",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
