# Self-hosted: real users, on a machine you run, with no AWS account.
#
#   cp .env.selfhosted.example .env.selfhosted
#   npm run secrets:generate     # paste the two values below
#   npm run migrate:selfhosted   # not `npm run migrate`, which reads .env, the dev database
#   BOOTSTRAP_PASSWORD='...' npm run bootstrap -- --email you@example.co.za --name "Your Name"
#   cd .. && npm run selfhost:build && npm run selfhost:start
#
# The difference from .env is that identity is real here. src/server.ts checks a password on
# every request; the development server in src/local.ts trusts an x-dev-sub header instead,
# and refuses to start in this mode for that reason.

NODE_ENV=production
APP_MODE=self-hosted
AWS_REGION=af-south-1

# Bind loopback and put a TLS terminator in front (Caddy, nginx, a tunnel). 0.0.0.0 puts this
# on the local network in plaintext, including session tokens.
HOST=127.0.0.1
PORT=3001

# The address other devices reach this server on. Signed document and upload links are built
# from it, so left unset they point at localhost and only work on this machine.
PUBLIC_API_URL=http://127.0.0.1:3001

# Set to true only behind a reverse proxy you control. The client address then comes from
# X-Forwarded-For, which is what the sign-in rate limit and signature records use. Without a
# proxy every request would otherwise look like it came from the proxy's own address.
TRUST_PROXY=false

# The scheduled jobs (invoices, deposit interest, lease activation, notifications) run inside
# this process on a timer. Set to false to run them from cron instead: npm run jobs -- <name>.
# Cron mode needs Postgres: on PGlite the server holds the folder and `npm run jobs` refuses.
RUN_JOBS=true

# Where `npm run selfhost:build` leaves the web app. The server serves it from this same port,
# so the browser makes no cross-origin call and there is no CORS to configure.
WEB_ROOT=../app/dist

# PGlite needs nothing installed and is one process against one folder: no replication, no
# pg_dump. Back up this directory on a schedule, with the server stopped. For anything with
# more than one landlord, install Postgres and use the block below instead.
DB_DRIVER=pglite
PGLITE_DIR=./.pglite-selfhosted

# Real Postgres. DB_SSL=off is accepted only while DB_HOST is loopback.
#DB_DRIVER=postgres
#DB_HOST=127.0.0.1
#DB_PORT=5432
#DB_NAME=tms
#DB_USER=tms_app
#DB_PASSWORD=
#DB_SSL=off

# Not used in this mode, but lib/env.ts requires them at import time. Placeholders are correct.
# DB_HOST and DB_NAME are set above when the postgres block is in use.
DB_HOST=127.0.0.1
DB_NAME=tms
DB_SECRET_ARN=unused-in-self-hosted
DOCS_BUCKET=unused-in-self-hosted
KMS_KEY_ID=unused-in-self-hosted

# Documents and photos on disk, served over HMAC-signed links that expire, exactly as the
# presigned S3 URLs do. Back this directory up with the database: it holds signed leases.
STORAGE_DRIVER=local
STORAGE_DIR=./.storage-selfhosted
KMS_DRIVER=local

# Email and password sign-in against the local_credential table. There is no Cognito here.
AUTH_DRIVER=local

# Both from `npm run secrets:generate`. At least 32 characters, and the server refuses to
# start on the example values published in this repository.
AUTH_SECRET=
STORAGE_SECRET=

# The address people open the app on, behind your TLS terminator. Password reset emails link
# here. Without it, Forgot password answers that it is not set up.
PUBLIC_APP_URL=https://rentals.example.co.za

# skip drains the outbox and logs what it would have sent, so nothing is emailed until you
# choose to. smtp sends through any mailbox that offers SMTP (Gmail with an app password,
# your domain's host, Mailgun). send is Amazon SES and is for the AWS deployment.
NOTIFY_MODE=skip
#NOTIFY_MODE=smtp
#SMTP_URL=smtps://you%40example.com:app-password@smtp.gmail.com:465
NOTIFY_FROM=no-reply@example.invalid
# Replies to notifications go here. Leave unset and replies to no-reply vanish.
#NOTIFY_REPLY_TO=you@example.com

# Postgres connections for the self-hosted server (ignored by PGlite).
#DB_POOL_MAX=10
