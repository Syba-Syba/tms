NODE_ENV=development
AWS_REGION=af-south-1

# pglite runs Postgres inside this process against a folder on disk. Nothing to install,
# nothing to start. Switch to postgres below once you want a real server.
DB_DRIVER=pglite
PGLITE_DIR=./.pglite

# Used only when DB_DRIVER is not pglite.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tms
DB_USER=tms_app
DB_PASSWORD=local-only-password
DB_SSL=off

# Read only when running in Lambda. Placeholders are fine locally.
DB_SECRET_ARN=arn:aws:secretsmanager:af-south-1:000000000000:secret:local
DOCS_BUCKET=tms-local-docs
KMS_KEY_ID=local-key

# Documents and photos live on disk under .storage, served by the dev server as signed URLs
# that behave like presigned S3 links. The ID number shim exists for the same reason: no AWS
# account should be needed to exercise any feature. Both refuse to run outside development.
STORAGE_DRIVER=local
STORAGE_DIR=./.storage
KMS_DRIVER=local

# The login screen talks to the local auth driver: email/password rows in local_credential,
# tokens signed with AUTH_SECRET. Production identity is Cognito; this refuses to run there.
AUTH_DRIVER=local
AUTH_SECRET=tms-local-dev-secret

# skip drains the outbox and logs what it would have sent, so no email is needed to develop.
NOTIFY_MODE=skip
NOTIFY_FROM=no-reply@example.invalid

# Landlord subscriptions. local simulates PayFast on the Plan screen; payfast takes real
# payments; off charges nobody (a self-hosted install run for one portfolio).
BILLING_DRIVER=local
# For BILLING_DRIVER=payfast. Sandbox credentials work with PAYFAST_SANDBOX=true. PayFast must
# be able to reach PUBLIC_API_URL/billing/notify, so it cannot be localhost.
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=
# PAYFAST_SANDBOX=true
# PUBLIC_API_URL=
